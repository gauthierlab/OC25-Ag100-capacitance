# cluster.env -- the ONLY file with cluster-specific settings for the S0 jobs.
# Copy to cluster.env (same directory) and fill in. All three submit_*.sh scripts source it.
# SLURM resource options (partition, time, GPUs) are passed on the sbatch command line instead;
# see ../README.md "Runbook".

# --- MD stage (OC25 MLIP, one GPU per state) ---
MD_MODULES="cuda/12.4"                        # space-separated list for `module load`; leave empty if none
CONDA_SH="$HOME/miniconda3/etc/profile.d/conda.sh"   # or the cluster's equivalent; leave empty to skip
CONDA_ENV="oc25"                              # env with fairchem-core, ase, numpy, scipy, pandas (see ../ENVIRONMENT.md)
HF_TOKEN=""                                   # HuggingFace token for the gated facebook/OC25 repo; leave empty if
                                              # `huggingface-cli login` was already run as this user

# --- DFT stage (VASP 6.3.2 single points + Bader) ---
DFT_MODULES="vasp/6.3.2"                      # space-separated list for `module load`
VASP_PP_PATH="/path/to/potpaw"                # must contain potpaw_PBE/{Ag,O,H,Na_pv,Cs_sv,F}/POTCAR
VASP_EXE="vasp_std"
MPIRUN="srun --mpi=pmix"                      # or: mpirun -np $SLURM_NTASKS
BADER_EXE="bader"                             # Henkelman group bader binary
CHGSUM_EXE="chgsum.pl"                        # from vtstscripts
NCORE="8"                                     # VASP NCORE for this node layout
